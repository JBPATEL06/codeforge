{
  "name": "codeforge",
  "version": "1.0.0",
  "description": "CodeForge — AI-mentored web development learning platform (BYOK)",
  "main": "out/main/index.js",
  "author": "CodeForge",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@monaco-editor/react": "^4.6.0",
    "bootstrap": "^5.3.3",
    "esbuild": "^0.23.0",
    "jquery": "^3.7.1",
    "monaco-editor": "^0.50.0",
    "openai": "^4.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.30",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.codeforge.app",
    "productName": "CodeForge",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "CodeForge-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ]
  }
}
